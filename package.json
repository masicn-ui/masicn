{
  "name": "@masicn/ui",
  "version": "0.0.1",
  "description": "Core design system for masicn — tokens, theme, primitives, hooks",
  "author": {
    "name": "Manish Kumar",
    "email": "manishkumar0225@outlook.com",
    "url": "https://manishh.in"
  },
  "publisher": "masicn-ui",
  "homepage": "https://masicn-ui.github.io/masicn-ui/",
  "repository": {
    "type": "git",
    "url": "https://github.com/masicn-ui/masicn.git"
  },
  "bugs": {
    "url": "https://github.com/masicn-ui/registry/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react-native",
    "ui",
    "design-system",
    "tokens",
    "theme",
    "masicn",
    "primitives",
    "copy-paste",
    "shadcn",
    "dark-mode",
    "animation",
    "reanimated"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}